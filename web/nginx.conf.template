server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve external hostnames (Google DNS + Docker internal DNS)
    resolver 8.8.8.8 127.0.0.11 valid=30s;

    # Use variables so nginx resolves DNS at request time, not just at startup
    set $backend_url ${BACKEND_SCHEME}://${BACKEND_HOST};

    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass $backend_url;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    location /r/ {
        proxy_pass $backend_url$request_uri;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}